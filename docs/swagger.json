                "bedrooms": {
                    "type": "integer",
                    "example": 3
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-03-23T10:00:00Z"
                },
                "description": {
                    "type": "string",
                    "example": "Modern penthouse with ocean view and automated lighting."
