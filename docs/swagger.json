    "definitions": {
        "models.CreateListingRequest": {
            "type": "object",
            "required": [
                "agent_id",
                "bedrooms",
                "location",
                "price",
                "title",
                "type"
            ],
            "properties": {
                "agent_id": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "agent_1001"
                },
                "bathrooms": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 3
                },
                "bedrooms": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 3
                },
                "description": {
                    "type": "string",
                    "maxLength": 2000,
                    "example": "Modern penthouse with ocean view."
                },
                "location": {
                    "$ref": "#/definitions/models.Location"
                },
                "price": {
                    "type": "number",
                    "minimum": 0,
                    "example": 185000000
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "Luxury 3-Bedroom Penthouse in Ikoyi"
                },
                "type": {
                    "enum": [
                        "rent",
                        "sale",
                        "shortlet"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.ListingType"
                        }
                    ],
                    "example": "sale"
                }
            }
        },
        "models.FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
