                "updated_at": {
                    "type": "string",
                    "example": "2026-03-23T10:00:00Z"
                }
            }
        },
        "models.ListingType": {
            "type": "string",
            "enum": [
                "rent",
                "sale",
                "shortlet"
            ],
            "x-enum-varnames": [
                "ListingTypeRent",
                "ListingTypeSale",
                "ListingTypeShortlet"
            ]
