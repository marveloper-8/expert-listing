        "/listings/search": {
            "get": {
                "description": "Filters by type, price range, bedrooms, and returns listings within radius_km of a given coordinate",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Listings"
                ],
                "summary": "Search listings by filters and location radius",
                "parameters": [
                    {
                        "enum": [
                            "rent",
                            "sale",
                            "shortlet"
                        ],
                        "type": "string",
                        "description": "Listing type",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "number",
                        "description": "Minimum price",
                        "name": "min_price",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "number",
                        "description": "Maximum price",
                        "name": "max_price",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Exact bedroom count",
                        "name": "bedrooms",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Minimum bedroom count",
                        "name": "min_bedrooms",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "City name",
                        "name": "city",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Latitude for radius search (-90 to 90)",
                        "name": "lat",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Longitude for radius search (-180 to 180)",
                        "name": "lng",
                        "in": "query"
                    },
                    {
                        "minimum": 0.1,
                        "type": "number",
                        "description": "Radius in kilometers",
                        "name": "radius_km",
                        "in": "query"
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "default": 1,
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 10,
                        "description": "Items per page (default: 10, max: 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "created_at",
                            "price",
                            "bedrooms",
                            "distance"
                        ],
                        "type": "string",
                        "default": "created_at",
                        "description": "Sort field",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "default": "desc",
                        "description": "Sort order",
                        "name": "order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/models.StandardResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/models.Listing"
                                            }
                                        },
                                        "pagination": {
                                            "$ref": "#/definitions/models.PaginationMetadata"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.StandardResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
