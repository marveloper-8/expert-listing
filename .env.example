# Server Configuration
PORT=8080
ENV=development
ALLOWED_ORIGINS=*

# Database Configuration
# Options: 'postgres' or 'sqlite'
DB_DRIVER=sqlite

# If DB_DRIVER=sqlite:
DATABASE_URL=expertlisting.db

# If DB_DRIVER=postgres, use either DATABASE_URL or discrete fields below:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/expertlisting?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=expertlisting
# DB_SSLMODE=disable
# DB_TIMEZONE=UTC
